{
  "expo": {
    "name": "TinyRest",
    "slug": "tiny-rest",
    "version": "10.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tinyrest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.afre92.tinyrest",
      "buildNumber": "3",
      "appleTeamId": "NQ6AG8RHP3",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.afre92.tinyrest"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.afre92.tinyrest"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@bacons/apple-targets",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "backgroundColor": "#6E9AB1"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "owner": "afre92",
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.afre92.tinyrest.widget",
                  "targetName": "widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.afre92.tinyrest"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "01e9739f-9cb0-428a-a998-249f0d50b7aa"
      }
    }
  }
}
